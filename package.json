{
  "name": "@maptiler/tilestats",
  "version": "2.0.0",
  "description": "Generate statistics about geographic data.",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "bin": {
    "tilestats-generate": "bin/tilestats-generate",
    "tilestats-validate": "bin/tilestats-validate"
  },
  "scripts": {
    "lint": "eslint lib test bin/**",
    "lint-fix": "eslint --fix lib test bin/**",
    "test": "npm run lint && node --test test/*.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" test/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maptiler/tilestats.git"
  },
  "contributors": ["MapTiler", "Mapbox"],
  "license": "ISC",
  "homepage": "https://github.com/maptiler/tilestats#readme",
  "dependencies": {
    "@mapbox/mapbox-file-sniff": "^1.0.5",
    "@mapbox/mbtiles": "^0.12.1",
    "@mapbox/tilelive": "^6.1.1",
    "@mapbox/tiletype": "^0.3.0",
    "@mapbox/vector-tile": "^1.2.1",
    "@mapnik/mapnik": "^4.8.2",
    "d3-queue": "^3.0.7",
    "jsonschema": "^1.4.1",
    "lodash.isplainobject": "^4.0.6",
    "meow": "^9.0.0",
    "pbf": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^8.43.0",
    "eslint-plugin-node": "^11.1.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "node-gyp": "^12.4.0"
  }
}
